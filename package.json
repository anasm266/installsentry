{
  "name": "installsentry",
  "version": "0.1.0",
  "type": "module",
  "description": "Supply-chain blast-radius visualizer that traces npm install-time lifecycle scripts, file/network access, and secret-canary reads.",
  "main": "dist/cli.js",
  "bin": {
    "installsentry": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anasm266/installsentry.git"
  },
  "bugs": {
    "url": "https://github.com/anasm266/installsentry/issues"
  },
  "homepage": "https://github.com/anasm266/installsentry#readme",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-shim-assets.mjs",
    "dev": "tsc --watch",
    "pretest": "npm run build && node scripts/ensure-test-fixture-deps.mjs",
    "test": "vitest",
    "test:ci": "npm run build && node scripts/ensure-test-fixture-deps.mjs && vitest run",
    "test:all": "npm run test:ci && npm run lint",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run test:ci"
  },
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "lifecycle-scripts",
    "dependency-graph"
  ],
  "author": "anas",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "esbuild": "0.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
